        {
            "entity_type": "product",
            "local_identifier": "https://blog.ehri-project.eu/2026/04/30/scholars-path-through-fragmentation/",
            "identifiers": [
                {
                    "scheme": "doi",
                    "value": "10.82169/9pnj-35bm"
                },
                {
                    "scheme": "url",
                    "value": "https://blog.ehri-project.eu/2026/04/30/scholars-path-through-fragmentation/"
                }
            ],
            "product_type": "literature",
            "titles": {
                "en": "Holocaust Studies in Ukraine: A Scholar’s Path through Fragmentation"
            },
            "abstracts": {
                "en": "I have been involved in Holocaust Studies since the early 2000s, when the field was only beginning to take shape in Ukraine. Rather than a conventional academic trajectory, my entry into Holocaust research did not follow a linear or institutionally guided path, but unfolded through fragmented encounters, external frameworks, and improvised research practices."
            },
            "topics": [
                {
                    "term": "https://blog.ehri-project.eu/tag/historiography/",
