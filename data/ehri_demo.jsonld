        {
            "entity_type": "product",
            "local_identifier": "https://blog.ehri-project.eu/2026/05/29/a-child-is-born-harry-wapniarka/",
            "identifiers": [
                {
                    "scheme": "doi",
                    "value": "10.82169/6njj-cnqx"
                },
                {
                    "scheme": "url",
                    "value": "https://blog.ehri-project.eu/2026/05/29/a-child-is-born-harry-wapniarka/"
                }
            ],
            "product_type": "literature",
            "titles": {
                "en": "“A Child is Born”: The Mysterious Case of Harry Wapniarka"
            },
            "abstracts": {
                "en": "My research on the events that took place in the notorious Vapniarka camp—known as the “Camp of Death” due to the exterminatory conditions imposed on the approximately 1200 deportees, including the toxic pea fodder (lathyrus sativus) provided as food by the Romanian authorities—actually began with a focus on the art produced as antifascist resistance during the Holocaust."
            },
